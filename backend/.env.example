APP_NAME=ACICU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database (MySQL / Laragon) ----
# Buat dulu database kosong bernama "acicu" lewat HeidiSQL / phpMyAdmin.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acicu
DB_USERNAME=root
DB_PASSWORD=

# Backend ini API murni: tanpa sesi/antrean/cache database.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---- CORS: alamat frontend yang boleh memanggil API (pisahkan dengan koma) ----
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# ---- Pengaturan bisnis ACICU (SEMUA nilai di bawah ini hanya CONTOH, ganti sebelum dipakai sungguhan) ----
ACICU_SHIPPING_FEE=5000
# Slot jam kirim bawaan: tiap jam 06:00 - 22:00. Isi hanya jika ingin mengganti (dipisah koma), atau ubah dari panel admin.
# ACICU_DELIVERY_SLOTS=06:00,07:00,08:00
ACICU_PAYMENT_TTL_MINUTES=60
ACICU_ORDER_CUTOFF_MINUTES=90
ACICU_BATCH_LABEL="Batch 1"
ACICU_BANK_NAME=BCA
ACICU_BANK_ACCOUNT=827-091-2384
ACICU_BANK_HOLDER="Aneka Aci Bungcu"
# Path QRIS di storage publik, mis. qris/qris.png (taruh file di storage/app/public/qris/). Kosong = placeholder.
ACICU_QRIS_IMAGE=
ACICU_WHATSAPP=6282286512274
ACICU_WHATSAPP_DISPLAY=082286512274
ACICU_INSTAGRAM=acicu.licious
ACICU_TIKTOK=acicu.licious
ACICU_ADMIN_HOURS="08:00 - 19:00 WIB"

# ---- Bukti pembayaran: false = opsional, true = wajib diunggah pelanggan ----
ACICU_REQUIRE_PROOF=false

# ---- Pemberitahuan ke pemilik saat ada pembayaran menunggu validasi: off | telegram | log ----
ACICU_OWNER_NOTIFY=off
ACICU_TELEGRAM_BOT_TOKEN=
ACICU_TELEGRAM_CHAT_ID=

# ---- Akun admin awal (dibuat oleh `php artisan db:seed`) ----
ACICU_OWNER_EMAIL=owner@acicu.test
ACICU_ADMIN_EMAIL=admin@acicu.test
# Kosongkan agar seeder membuat sandi acak (ditampilkan sekali di terminal). Jangan commit sandi asli.
ACICU_OWNER_PASSWORD=
ACICU_ADMIN_PASSWORD=
